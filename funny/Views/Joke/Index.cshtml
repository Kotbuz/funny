@model string[]

<div class="text-center">
    <h6 class="not-visible">Updated</h6>
    <h3>Your answer is:</h3>
    <h1>Press the button!</h1>
    <button id="btn-joke">Get a new answer</button>
</div>

<script>
    // Теперь Razor четко знает, что Model — это массив строк, и корректно передаст его в JS
    window.jokeAnswers = @Html.Raw(Json.Serialize(Model));
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/joke.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/joke.js" asp-append-version="true"></script>
}
